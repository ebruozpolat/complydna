# The wallet address that RECEIVES USDC payments on Base Sepolia.
# This is a public address (0x...), not a private key.
ADDRESS=0xYourReceivingAddressHere

# Network for payments. Keep base-sepolia for the testnet demo.
NETWORK=base-sepolia

# Port the seller API listens on.
PORT=4021

# Facilitator that verifies + settles payments.
#   - Leave this UNSET (commented out) to use the bundled LOCAL facilitator.
#     The demo then runs end-to-end with NO funds and NO external network
#     (settlement is simulated in-process — no real USDC moves).
#   - Set it to a REAL facilitator for real on-chain USDC settlement on Base
#     Sepolia (the buyer wallet must be funded with test USDC).
# FACILITATOR_URL=https://x402.org/facilitator
