# The wallet address that RECEIVES USDC payments on Base Sepolia.
# This is a public address (0x...), not a private key.
ADDRESS=0xYourReceivingAddressHere

# Network for payments. Keep base-sepolia for the testnet demo.
NETWORK=base-sepolia

# Port the seller API listens on.
PORT=4021

# Optional: override the x402 facilitator that verifies + settles payments.
# Leave this commented out to use the default hosted testnet facilitator
# (https://x402.org/facilitator).
# FACILITATOR_URL=https://x402.org/facilitator
